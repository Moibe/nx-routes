# nx-routes: ruta de kcal.moibe.me → app SvelteKit (nutricion_front) en 127.0.0.1:3600 (pm2).
# El nombre de ESTE archivo debe ser EXACTAMENTE el dominio: kcal.moibe.me
#
# Las líneas "# managed by Certbot" las gestiona certbot al correr en el droplet:
#     sudo certbot --nginx -d kcal.moibe.me
# Si nginx se queja de que el cert aún no existe (primer deploy del dominio):
#   1) obtén el cert primero:  sudo certbot certonly --nginx -d kcal.moibe.me
#   2) crea el symlink + reload (ver checklist).

server {
    server_name kcal.moibe.me;

    location / {
        proxy_pass http://127.0.0.1:3600;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # /api/* (proxy propio del front hacia nutricion_api) incluye /chat,
        # que puede tardar varios segundos en OpenAI -- default de nginx
        # (60s) es justo para eso. Ahora que el browser ya no le habla
        # directo a kcal-api.moibe.me, este es el timeout que de verdad
        # aplica a esas llamadas.
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kcal.moibe.me/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kcal.moibe.me/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    # 15M para que quepa una foto del chat en base64 (tope de la app:
    # 12_000_000 caracteres de imagen + el resto del JSON) sin quedar justo
    # contra el límite.
    client_max_body_size 15M;
}

server {
    if ($host = kcal.moibe.me) { return 301 https://$host$request_uri; } # managed by Certbot
    listen 80;
    server_name kcal.moibe.me;
    return 404; # managed by Certbot
}

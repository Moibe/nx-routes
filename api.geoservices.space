server {
    if ($host = api.geoservices.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name api.geoservices.space;
    return 404;


}

server {
    server_name api.geoservices.space;

    # ACCESO RESTRINGIDO.
    #
    # Esta API (geospace_nucleo) no tiene autenticacion propia, y POST /api/ask
    # pasa preguntas libres a OpenAI con la llave del proyecto y ejecuta el SQL
    # resultante contra la base. Hasta el 2026-10-13 estaba abierta a internet.
    # Ahora todo el vhost pide usuario y contrasena (HTTP Basic sobre HTTPS).
    #
    # Las credenciales viven en /etc/nginx/geospace.htpasswd, FUERA del repo
    # (hash SHA-512 crypt). Para cambiarlas:
    #   printf 'moibe:%s\n' "$(openssl passwd -6 'NUEVA')" > /etc/nginx/geospace.htpasswd
    auth_basic           "Geospace";
    auth_basic_user_file /etc/nginx/geospace.htpasswd;

    location /api/ {
        proxy_pass         http://127.0.0.1:8001/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_read_timeout  120s;
        proxy_send_timeout  120s;
    }

    location /docs {
        proxy_pass         http://127.0.0.1:8001/docs;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location /openapi.json {
        proxy_pass         http://127.0.0.1:8001/openapi.json;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    location = / {
        proxy_pass http://127.0.0.1:8001/;
        proxy_set_header Host $host;
    }

    listen 443 ssl;

    ssl_certificate /etc/letsencrypt/live/api.geoservices.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/api.geoservices.space/privkey.pem; # managed by Certbot
}
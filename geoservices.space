# nx-routes: geoservices.space -> svelte_geo (SvelteKit + adapter-node, pm2, 127.0.0.1:3900)
#                                 /track/ -> geospace-track (FastAPI + SQLite, pm2, 127.0.0.1:8003)
#                                            SOLO POST /track/api/map-interactions y GET /track/health;
#                                            el resto de /track/ es 404 a proposito (la API no tiene auth)
#
# OJO: el bloque 443 de abajo es el UNICO `default_server` de todo nx-routes.
# Si se pierde esa palabra al editar, cambia el comportamiento HTTPS del droplet
# entero para cualquier host no reconocido, no solo el de este dominio.
#
# ROLLBACK: este dominio se servia como archivos estaticos desde
# /root/code/svelte_geo/dist. La copia congelada de esa version vive en
# /root/code/svelte_geo_dist_rollback. Para volver: `git revert` del commit que
# introdujo el proxy_pass, apuntando el root a ese directorio.

server {
    server_name geoservices.space www.geoservices.space;

    # www -> apex. NO es cosmetico: adapter-node compara el Origin de cada
    # request contra la variable ORIGIN (https://geoservices.space). Todo lo que
    # entre por www queda con el origen desalineado y eso rompe cookies secure
    # y el CSRF de las form actions. Mismo patron que quiniela/DEPLOY.md.
    if ($host = www.geoservices.space) {
        return 301 https://geoservices.space$request_uri;
    }

    # API de tracking (geospace-track) — SOLO ESCRITURA PUBLICA.
    #
    # El navegador necesita exactamente una cosa: POST /track/api/map-interactions.
    # Antes este bloque proxeaba TODA la API (location /track/ con proxy_pass a
    # la raiz), y la API no tiene autenticacion: cualquiera podia bajar la tabla
    # entera con un GET anonimo — ids de cliente de GA, coordenadas de IP y de
    # GPS reales, gclid/fbclid y, cuando se usa el modo telefono, los numeros
    # buscados. Tambien quedaban publicos /docs y /openapi.json.
    #
    # Los lectores legitimos (geospace_nucleo, que corre en este mismo droplet)
    # leen directo de http://127.0.0.1:8003 y no pasan por nginx. No apuntarlos
    # a https://geoservices.space/track.
    #
    # Se listan las rutas EXACTAS (location =) y todo lo demas bajo /track/ da
    # 404: asi una ruta nueva que se agregue a la API nace privada, en vez de
    # nacer publica por herencia.
    location = /track/api/map-interactions {
        limit_except POST {
            deny all;
        }
        proxy_pass http://127.0.0.1:8003/api/map-interactions;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Health check: lo usan el watcher de ntfy y el paso de verificacion del
    # deploy de svelte_geo. No expone datos.
    location = /track/health {
        proxy_pass http://127.0.0.1:8003/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location /track/ {
        return 404;
    }

    # La app.
    #
    # Ya no hay `root` ni `try_files`: los sirve SvelteKit. Tampoco los bloques
    # de cache que habia antes — adapter-node ya manda Cache-Control immutable
    # para /_app/immutable/ y no-cache para el HTML. Dejarlos apuntando a un
    # dist/ que nadie actualiza habria servido archivos viejos.
    location / {
        proxy_pass http://127.0.0.1:3900;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    listen 443 ssl default_server; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/geoservices.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/geoservices.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = geoservices.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = www.geoservices.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name geoservices.space www.geoservices.space;
    listen 80;
    return 404; # managed by Certbot
}

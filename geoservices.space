# nx-routes: geoservices.space -> svelte_geo (sitio estatico en /root/code/svelte_geo/dist)
# mas /track/ -> geospace-track (FastAPI + SQLite, pm2, 127.0.0.1:8003).
#
# OJO: el bloque 443 de abajo es el UNICO `default_server` de todo nx-routes.
# Si se pierde esa palabra al editar, cambia el comportamiento HTTPS del droplet
# entero para cualquier host no reconocido, no solo el de este dominio.

server {
    server_name geoservices.space www.geoservices.space;
    root /root/code/svelte_geo/dist;

    # API de tracking (geospace-track).
    #
    # El navegador antes escribia a moibe-fastapi-mariadb-geospaces.hf.space:
    # salto cross-origin + preflight CORS + un Space que duerme + otro salto a
    # MariaDB en Opalstack. Con este bloque el tracking es mismo-origen y la
    # escritura termina en un archivo del mismo disco.
    #
    # La diagonal final de proxy_pass NO es opcional: hace que
    # /track/api/map-interactions llegue al backend como /api/map-interactions.
    location /track/ {
        proxy_pass http://127.0.0.1:8003/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # Cache para archivos estáticos (JS/CSS con hash en nombre)
    location ~* ^/(_app/|assets/).*\.(js|css|png|jpg|jpeg|gif|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html y archivos estáticos
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Política de cache para index.html (no cachear)
    location = /index.html {
        expires -1;
        add_header Cache-Control "public, must-revalidate";
    }

    listen 443 ssl default_server; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/geoservices.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/geoservices.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = geoservices.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    if ($host = www.geoservices.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name geoservices.space www.geoservices.space;
    listen 80;
    return 404; # managed by Certbot
}

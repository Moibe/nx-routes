# nx-routes: ruta de coleccionador.live → heich-gi (PWA tracker GPS, SvelteKit) en 127.0.0.1:3300 (pm2).
# El nombre de ESTE archivo debe ser EXACTAMENTE el dominio: coleccionador.live
#
# Primer deploy del dominio (cert aún no existe):
#   1) sudo certbot certonly --nginx -d coleccionador.live -d www.coleccionador.live
#   2) symlink + reload:
#        cd /etc/nginx/sites-enabled
#        ln -s /etc/nginx/sites-available/coleccionador.live coleccionador.live
#        nginx -t && systemctl reload nginx
#
# www → apex forzado: una PWA vive atada a su origin (permiso de geolocalización,
# manifest, instalación); www y apex son origins DISTINTOS, así que todo va al apex
# (y ORIGIN=https://coleccionador.live siempre cuadra).

server {
    server_name coleccionador.live www.coleccionador.live;

    if ($host = www.coleccionador.live) { return 301 https://coleccionador.live$request_uri; }

    location / {
        proxy_pass http://127.0.0.1:3300;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/coleccionador.live/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/coleccionador.live/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    client_max_body_size 12M;
}

server {
    if ($host = www.coleccionador.live) { return 301 https://coleccionador.live$request_uri; }
    if ($host = coleccionador.live)     { return 301 https://$host$request_uri; }
    listen 80;
    server_name coleccionador.live www.coleccionador.live;
    return 404;
}

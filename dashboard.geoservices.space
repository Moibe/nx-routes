server {
    server_name dashboard.geoservices.space;
    root /root/code/geospace_dashboard/dist;

    # ACCESO RESTRINGIDO: el dashboard y la API de nucleo (mas abajo) piden
    # usuario y contrasena. Las credenciales son las mismas que las de
    # api.geoservices.space y viven en /etc/nginx/geospace.htpasswd, fuera del
    # repo. Hasta el 2026-10-13 ambos eran publicos.
    auth_basic           "Geospace";
    auth_basic_user_file /etc/nginx/geospace.htpasswd;

    # La API de nucleo se sirve desde ESTE MISMO origen.
    #
    # Antes el dashboard le hablaba a https://api.geoservices.space desde el
    # navegador, o sea cross-origin: ahi un usuario y contrasena de HTTP Basic
    # no sirven, porque los navegadores no mandan credenciales en peticiones
    # cross-origin salvo que la API responda con CORS especifico. Con la API
    # colgada de este vhost, un solo login protege el dashboard y los datos, y el
    # navegador reenvia las credenciales solo en cada llamada.
    location /api/ {
        proxy_pass         http://127.0.0.1:8001/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        proxy_read_timeout  120s;
        proxy_send_timeout  120s;
    }

    # Cache para archivos estáticos (JS/CSS con hash en nombre)
    location ~* ^/(_app/|assets/).*\.(js|css|png|jpg|jpeg|gif|svg|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html y archivos estáticos
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Política de cache para index.html (no cachear)
    location = /index.html {
        expires -1;
        add_header Cache-Control "public, must-revalidate";
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/dashboard.geoservices.space/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/dashboard.geoservices.space/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    if ($host = dashboard.geoservices.space) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    server_name dashboard.geoservices.space;
    listen 80;
    return 404; # managed by Certbot
}

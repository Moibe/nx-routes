# nx-routes: ruta de shapeup.moibe.me → app SvelteKit en 127.0.0.1:3800 (pm2, shape_up_moibe).
# El nombre de ESTE archivo debe ser EXACTAMENTE el dominio: shapeup.moibe.me
#
# Las líneas "# managed by Certbot" las gestiona certbot al correr en el droplet.
# OJO: en este droplet `certbot --nginx` para un dominio NUEVO no siempre encuentra
# este archivo (si no hay symlink en sites-enabled todavía) y a veces le pega el
# bloque SSL al server_name equivocado (le pasó con admin.moibe.me, capital.moibe.me
# y aquí también) — por eso el bloque SSL de abajo se armó a mano contra el cert que
# certbot sí emitió bien, en vez de dejar que --nginx lo "instale".

server {
    server_name shapeup.moibe.me;

    location / {
        proxy_pass http://127.0.0.1:3800;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/shapeup.moibe.me/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/shapeup.moibe.me/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
    client_max_body_size 12M;
}

server {
    if ($host = shapeup.moibe.me) { return 301 https://$host$request_uri; } # managed by Certbot
    listen 80;
    server_name shapeup.moibe.me;
    return 404; # managed by Certbot
}

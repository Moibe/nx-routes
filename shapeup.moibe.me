# nx-routes: ruta de shapeup.moibe.me → app SvelteKit en 127.0.0.1:3800 (pm2, shape_up_moibe).
# El nombre de ESTE archivo debe ser EXACTAMENTE el dominio: shapeup.moibe.me
#
# Pendiente hasta que el DNS de shapeup.moibe.me apunte a este droplet (165.22.53.200):
#   sudo certbot --nginx -d shapeup.moibe.me
# Certbot reescribe este archivo agregando el bloque SSL (443) + el redirect 80→443
# automáticamente. Mientras tanto, sirve en plano por HTTP (puerto 80).

server {
    server_name shapeup.moibe.me;

    location / {
        proxy_pass http://127.0.0.1:3800;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    listen 80;
    client_max_body_size 12M;
}
